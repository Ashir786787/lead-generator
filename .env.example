# ── Core ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Lead Finder
NODE_ENV=development

# PostgreSQL. With Docker: postgres://leadfinder:leadfinder@localhost:5432/leadfinder
# With the bundled local Postgres fallback (`pnpm db:up`): port 5433.
DATABASE_URL=postgres://leadfinder:leadfinder@localhost:5433/leadfinder

# Session secret for Better Auth (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# First-run setup: owner email hint shown on the setup screen (optional)
OWNER_EMAIL=
ALLOW_SIGNUP=false

# Timezone used for new workspaces (IANA name)
DEFAULT_TIMEZONE=UTC

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DIR=.data/storage

# ── Import limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=52428800
ZIP_MAX_ENTRIES=200
ZIP_MAX_TOTAL_UNCOMPRESSED=209715200
ZIP_MAX_ENTRY_UNCOMPRESSED=52428800
ZIP_MAX_COMPRESSION_RATIO=100

# ── Scanner ──────────────────────────────────────────────────────────────────
SCAN_USER_AGENT=LeadFinderBot/1.0 (+https://example.com/bot)
SCAN_MAX_PAGES=4
SCAN_CACHE_DAYS=7
SCAN_CONNECT_TIMEOUT_MS=5000
SCAN_TOTAL_TIMEOUT_MS=15000
SCAN_MAX_BODY_BYTES=2097152
SCAN_GLOBAL_CONCURRENCY=5
SCAN_PER_HOST_DELAY_MS=1000
SCAN_RETRIES=2
# Test-only escape hatch. Startup fails in production if set.
ALLOW_PRIVATE_TARGETS_FOR_TESTS=false

# ── Discovery ────────────────────────────────────────────────────────────────
# Overpass is only used when the Nominatim POI index has no matches.
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# Comma-separated fallback mirrors. The app retries 429/5xx failures across them.
OVERPASS_ENDPOINTS=
OVERPASS_CACHE_MINUTES=60
# One attempt per mirror. Busy/failed Overpass queries fall back to Nominatim.
OVERPASS_TIMEOUT_MS=20000
OVERPASS_RETRIES=0
# Optional. Leave empty → Google provider shows an explicit unavailable state.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DAILY_BUDGET=100

# Geocoding for the map preview uses Nominatim. Set a real contact UA in production.
GEOCODE_ENDPOINT=https://nominatim.openstreetmap.org/search
GEOCODE_CACHE_MINUTES=1440
GEOCODE_USER_AGENT=LeadFinderBot/1.0 (+https://example.com/bot)

# ── AI search planner (optional) ─────────────────────────────────────────────
# These models only turn plain language into search filters. They never supply
# business records; real leads always come from OpenStreetMap or Google Places.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROK_API_KEY=
GROK_MODEL=grok-4
GROK_BASE_URL=https://api.x.ai/v1
# Groq Cloud (OpenAI-compatible). Note: Groq is not xAI Grok.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Jobs ─────────────────────────────────────────────────────────────────────
PG_BOSS_SCHEMA=pgboss
LOG_LEVEL=info
